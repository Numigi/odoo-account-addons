<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_statement_partner_mapping_tree_inherit" model="ir.ui.view">
        <field name="name">bank.statement.partner.mapping.tree.inherit</field>
        <field name="model">bank.statement.partner.mapping</field>
        <field name="inherit_id" ref="bank_statement_partner_mapping.bank_statement_partner_mapping_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='label']" position="after">
                 <field name="payment_id"/>
                <field name="journal_id"/>
                <field name="active" widget="boolean_toggle"/>
            </xpath>
             <xpath expr="//field[@name='mapping_type']" position="before">
                   <field name="create_date"/>
            </xpath>
        </field>
    </record>

    <record id="bank_statement_partner_mapping_view_search" model="ir.ui.view">
        <field name="name">bank.statement.partner.mapping.search</field>
        <field name="model">bank.statement.partner.mapping</field>
        <field name="arch" type="xml">
            <search string="Bank Statement Partner Mapping Search">
                <field name="partner_id"/>
                <field name="label"/>
                <field name="journal_id"/>
                 <field name="payment_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Journal" name="group_by_journal" context="{'group_by': 'journal_id'}"/>
                    <filter string="Partner" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>