<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_inherit_check_format" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.check.format</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='bank_account']" position="inside">
                <group string="Check Partner Mapping Configuration" attrs="{'invisible': [('type', '!=', 'bank')]}">
                    <field name="check_format"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>