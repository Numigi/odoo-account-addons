<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_transfer_improvements" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.transfer.improvements</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='payment_type']" position="attributes">
                <attribute name="invisible">is_internal_transfer</attribute>
            </xpath>

            <xpath expr="//field[@name='payment_method_line_id']" position="attributes">
                <attribute name="invisible">is_internal_transfer</attribute>
            </xpath>

        </field>
    </record>
</odoo>