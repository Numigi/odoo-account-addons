<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">Account Move: add reversed journal entry</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="to_check" position="after">
                <field name="reverse_entry_id" attrs="{'invisible': [('reverse_entry_id', '=', False)]}"/>
            </field>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_reversed_entries"  class="oe_stat_button" icon="fa-refresh" string="Reversed Entries" type="object" attrs="{'invisible': [('reverse_entry_id', '=', False)]}"/>
            </xpath>
        </field>
    </record>

</odoo>
