<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="invoice_supplier_form_with_fiscal_position_required" model="ir.ui.view">
        <field name="name">Invoice: Fiscal Position Required</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Only applied mandatory field on tab that only visible when move_type != entry -->
            <xpath expr="//page[@id='other_tab_entry']//field[@name='fiscal_position_id']" position="attributes">
                <attribute name="attrs">{
                    'required': [('state', '=', 'draft')],
                }</attribute>
            </xpath>
        </field>
    </record>

</odoo>
