#. module: account_journal_bank_exclusivity
#. odoo-python
#: code:addons/account_journal_bank_exclusivity/models/account_payment_method_line.py:0
msgid "An account is required for payment method %s on bank journal %s."
msgstr "Un compte est requis pour la méthode de paiement %s sur le journal de banque %s."

#. module: account_journal_bank_exclusivity
#. odoo-python
#: code:addons/account_journal_bank_exclusivity/models/account_journal.py:0
msgid "At least one inbound payment method must be configured."
msgstr "Au moins une méthode de paiement entrant doit être configurée."

#. module: account_journal_bank_exclusivity
#. odoo-python
#: code:addons/account_journal_bank_exclusivity/models/account_journal.py:0
msgid "At least one outbound payment method must be configured."
msgstr "Au moins une méthode de paiement sortant doit être configurée."

#. module: account_journal_bank_exclusivity
#. odoo-python
#: code:addons/account_journal_bank_exclusivity/hooks.py:0
msgid "Bank journal duplicates detected"
msgstr "Doublons de journaux de banque détectés"

#. module: account_journal_bank_exclusivity
#: model:ir.model,name:account_journal_bank_exclusivity.model_account_journal
msgid "Journal"
msgstr "Journal"

#. module: account_journal_bank_exclusivity
#: model:ir.model,name:account_journal_bank_exclusivity.model_account_payment_method_line
msgid "Payment Methods"
msgstr "Modes de paiement"

#. module: account_journal_bank_exclusivity
#. odoo-python
#: code:addons/account_journal_bank_exclusivity/models/account_journal.py:0
msgid "The bank account %s is already associated with journal %s."
msgstr "Le compte bancaire %s est déjà associé au journal %s."

#. module: account_journal_bank_exclusivity
#. odoo-python
#: code:addons/account_journal_bank_exclusivity/models/account_payment_method_line.py:0
msgid "The payment account %s is already used in journal %s."
msgstr "Le compte de paiement %s est déjà utilisé dans le journal %s."

#. module: account_journal_bank_exclusivity
#. odoo-python
#: code:addons/account_journal_bank_exclusivity/models/account_journal.py:0
msgid ""
"The suspense account %s cannot be shared between %s and %s due to "
"exclusivity rules."
msgstr ""
"Le compte d'attente %s ne peut pas être partagé entre %s et %s en raison des "
"règles d'exclusivité."

#. module: account_journal_bank_exclusivity
#. odoo-python
#: code:addons/account_journal_bank_exclusivity/models/account_journal.py:0
msgid ""
"You cannot modify the suspense account because transactions already exist "
"for this journal."
msgstr ""
"Vous ne pouvez pas modifier le compte d'attente car des transactions "
"existent déjà pour ce journal."