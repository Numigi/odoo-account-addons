msgid "<span class=\"o_form_label\">Fiscal Year</span>"
msgstr "<span class=\"o_form_label\">Exercice fiscal</span>"

#. module: account_additional_settings
#: model_terms:ir.ui.view,arch_db:account_additional_settings.res_config_settings_view_form
msgid ""
"<span class=\"o_form_label\">The following default accounts are used\n"
"                                    with certain features.</span>"
msgstr ""
"<span class=\"o_form_label\">Les comptes par défaut suivants sont utilisés "
"avec certaines fonctionnalités.</span>"

#. module: account_additional_settings
#: model:ir.model.fields,help:account_additional_settings.field_res_config_settings__account_journal_suspense_account_id
msgid ""
"Bank statements transactions will be posted on the\n"
"        suspense account until the final reconciliation allowing finding\n"
"        the right account."
msgstr ""
"Les mouvements bancaires seront comptabilisés sur le compte d'attente\n"
"        jusqu'au rapprochement définitif qui permettra de lettrer le mouvement sur\n"
"        le compte définitif."

#. module: account_additional_settings
#: model:ir.model,name:account_additional_settings.model_res_config_settings
msgid "Config Settings"
msgstr "Paramètres de config"

#. module: account_additional_settings
#: model:ir.model.fields,help:account_additional_settings.field_res_config_settings__property_stock_account_input_categ_id
msgid ""
"Counterpart journal items for all incoming stock moves\n"
"        will be posted in this account, unless there is a specific valuation\n"
"        account set on the source location. This is the default value\n"
"        for all productsin this category. It can also directly\n"
"        be set on each product."
msgstr ""
"Les écritures de contrepartie de tous les mouvements de stock\n"
"        entrants seront comptabilisées sur ce compte, sauf si un compte de valorisation est spécifiquement\n"
"        précisé pour l'emplacement d'origine. C'est la valeur par défaut pour tous les produits de cette catégorie. Il est également possible\n"
"        de la préciser directement su chaque produit."

